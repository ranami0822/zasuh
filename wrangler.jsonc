// ワーカーの設定（開発とデプロイで使う）。
// main は src/worker.ts。SvelteKit の出力に、定期実行を足した入口になっている。
// SvelteKit のビルドは wrangler.sveltekit.jsonc を読む（そちらは出力先を決めるためだけの設定）。
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zasuh",
	"main": "src/worker.ts",
	// src/worker.ts が読み込む、SvelteKit のビルドの出力。
	"alias": {
		"sveltekit-worker": "./.svelte-kit/cloudflare/_worker.js"
	},
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	// 本番のログ（投稿・通報・読み取りの失敗を、1行の JSON で出している）を、ダッシュボードで見られるようにする。
	"observability": { "enabled": true },
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "zasuh",
			// 本番のデータベース（2026-11-17 に作成）。ローカルの開発では使われない。
			"database_id": "ec217232-2ec9-47e0-9627-29d53b6999be",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"triggers": {
		// 毎分: 読めていないレビューを拾って、読み直す。
		"crons": ["* * * * *"]
	}
}
