{
	"name": "zasuh",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"dev:worker": "npm run build && wrangler dev --test-scheduled",
		"db:migrate:local": "wrangler d1 migrations apply DB --local"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261115.1",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22.20.5",
		"miniflare": "^5.20261113.0-beta",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.162.0"
	},
	"dependencies": {
		"@ui-sdk/core": "^0.1.0-beta.6",
		"@ui-sdk/svelte": "^0.1.0-beta.6"
	}
}
